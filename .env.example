# ==========================================
# MAXVEY E-COMMERCE CONFIGURATION (.env)
# ==========================================

# Port & App URL
PORT=3000
APP_URL="https://your-domain.com"

# Admin Authentication
# Default password for admin dashboard: "MaxveyAdmin2026!"
# Change this to a strong secret password for production.
ADMIN_PASSWORD="MaxveyAdmin2026!"
JWT_SECRET="maxvey_super_secure_jwt_token_secret_replace_in_production"

# Database Connection (Neon PostgreSQL or any PostgreSQL provider)
# If left empty, the server automatically uses persistent local database storage.
# Example Neon connection string:
DATABASE_URL="postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Paystack Payments (Nigeria - NGN)
# Get your keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Order Notifications — Email (Resend)
# Notifications sent to: maxwellunusual@gmail.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ADMIN_NOTIFICATION_EMAIL="maxwellunusual@gmail.com"

# Order Notifications — WhatsApp Cloud API (Official Meta / WhatsApp Platform)
# Notifications sent to: +2349029602573
ADMIN_NOTIFICATION_WHATSAPP="+2349029602573"
WHATSAPP_API_TOKEN="EAAxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="100xxxxxxxxxxxx"
WHATSAPP_TEMPLATE_NAME="maxvey_new_order"

